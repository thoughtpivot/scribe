{
    "name": "@thoughtpivot/scribe",
    "version": "1.2.0",
    "description": "Database modeling services.",
    "exports": "./dist/scribe.cli.js",
    "type": "module",
    "engines": {
        "node": "^20.19 || >=22.12"
    },
    "bin": {
        "scribe": "./dist/scribe.cli.js",
        "scribe-bun": "src/bun/server.ts"
    },
    "files": [
        "dist",
        "src/bun",
        "src/core.ts",
        "src/errors.ts",
        "src/schema-discovery.ts",
        "src/default.table.schema.json",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "rm -rf dist; node_modules/.bin/tsc --project .; cp ./src/default.table.schema.json ./dist/default.table.schema.json",
        "prepublishOnly": "npm run build",
        "test": "npm run build && node_modules/.bin/tsc --project tsconfig.test.json && cp ./src/default.table.schema.json ./dist-test/default.table.schema.json && node --test dist-test/routes.test.js dist-test/schema-discovery.test.js",
        "test:bun": "bun test --timeout 30000 src/routes.test.ts src/schema-discovery.test.ts src/bun",
        "start": "node_modules/.bin/ts-node src/scribe.cli.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/thoughtpivot/scribe.git"
    },
    "author": "Logikgate",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/thoughtpivot/scribe/issues"
    },
    "homepage": "https://github.com/thoughtpivot/scribe#readme",
    "dependencies": {
        "@aws-sdk/rds-signer": "3.1041.0",
        "@redis/client": "^1.2.0",
        "ajv": "6.15.0",
        "diff-match-patch": "^1.0.1",
        "dotenv": "^16.4.5",
        "express": "4.22.3",
        "express-bunyan-logger": "1.2.0",
        "fast-glob": "^3.3.3",
        "luxon": "3.4.4",
        "mkdirp": "3.0.1",
        "pg-promise": "11.10.2",
        "pgtools": "1.0.1",
        "pluralize": "8.0.0",
        "qs": "6.16.0",
        "redis": "4.6.13",
        "sqlstring": "2.3.3",
        "url-join": "5.0.0",
        "yargs": "17.7.2"
    },
    "devDependencies": {
        "@types/diff-match-patch": "^1.0.32",
        "@types/express": "4.17.13",
        "@types/express-serve-static-core": "^4.17.30",
        "@types/lodash": "^4.14.117",
        "@types/luxon": "3.4.2",
        "@types/mkdirp": "2.0.0",
        "@types/node": "^22.19.0",
        "@types/pg": "^8.11.2",
        "@types/pluralize": "0.0.29",
        "@types/request": "^2.47.1",
        "@types/serve-static": "^1.15.0",
        "@types/url-join": "4.0.0",
        "@types/yargs": "17.0.11",
        "@typescript-eslint/eslint-plugin": "5.33.1",
        "@typescript-eslint/parser": "5.33.1",
        "eslint": "8.22.0",
        "eslint-config-prettier": "8.5.0",
        "eslint-plugin-import": "2.26.0",
        "eslint-plugin-jsdoc": "39.3.6",
        "eslint-plugin-prettier": "4.2.1",
        "eslint-plugin-simple-import-sort": "7.0.0",
        "eslint-plugin-sort-class-members": "1.14.1",
        "prettier": "2.7.1",
        "prettier-eslint": "15.0.1",
        "ts-node": "10.9.1",
        "typescript": "5.9.3",
        "uglify-es": "3.3.9"
    }
}
