{
    "compilerOptions": {
        "strict": true,
        "target": "es2021",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "removeComments": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "allowSyntheticDefaultImports": true,
        "lib": ["es2021", "DOM"]
    },
    "include": ["src/**/*.ts"]
}
